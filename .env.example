# =============================================================================
# Highland Vault — environment template
#
#   cp .env.example .env
#
# .env is git-ignored. This file must never contain real credentials.
# Every value below is a LOCAL DEVELOPMENT placeholder that only works against
# the docker-compose stack bound to 127.0.0.1.
#
# Categories:
#   [required]    must be set in every environment (dev, CI, production)
#   [optional]    has a safe default
#   [dev-only]    used only by docker-compose / local tooling; never in production
#   [prod-only]   none are defined yet (Phase 1). Production values are
#                 provisioned via a secret manager, never via this file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# [optional] development | test | production (default: development)
NODE_ENV=development
# [optional] fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
# [required] api + worker runtime connection. Uses the DML-only role hv_app.
DATABASE_URL=postgres://hv_app:hv_app_local_dev_only@127.0.0.1:5432/highland_vault
# [required] migration tool connection. Uses the owner role hv_owner (DDL).
MIGRATION_DATABASE_URL=postgres://hv_owner:hv_owner_local_dev_only@127.0.0.1:5432/highland_vault

# --- Redis -------------------------------------------------------------------
# [required] api + worker (BullMQ, readiness check).
REDIS_URL=redis://127.0.0.1:6379/0

# --- API ---------------------------------------------------------------------
# [optional] default 127.0.0.1 / 4000
API_HOST=127.0.0.1
API_PORT=4000

# --- Web ---------------------------------------------------------------------
# [optional] server-side base URL the Next.js app uses to call the API (default http://127.0.0.1:4000)
API_BASE_URL=http://127.0.0.1:4000

# --- Tests (integration) -----------------------------------------------------
# [dev-only] owner-role connection to the maintenance DB. The test harness creates
# and drops throwaway databases (hv_test_*) through it. Needs CREATEDB.
TEST_DATABASE_ADMIN_URL=postgres://hv_owner:hv_owner_local_dev_only@127.0.0.1:5432/postgres
# [dev-only] Redis logical DB reserved for tests, isolated from the dev DB 0.
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# --- docker-compose (local infrastructure) -----------------------------------
# [dev-only] passwords used by the postgres container on FIRST start. They must
# match the URLs above. Changing them later requires `pnpm infra:reset`.
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev_only
HV_OWNER_PASSWORD=hv_owner_local_dev_only
HV_APP_PASSWORD=hv_app_local_dev_only
HV_DB_NAME=highland_vault
# [dev-only] host ports (all bound to 127.0.0.1)
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
