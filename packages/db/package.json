{
  "name": "@hv/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL access (Kysely), plain-SQL migration tool, and the real-PostgreSQL test harness.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate/cli.ts",
    "codegen": "node --env-file-if-exists=../../.env node_modules/kysely-codegen/dist/cli/bin.js",
    "codegen:verify": "node --env-file-if-exists=../../.env node_modules/kysely-codegen/dist/cli/bin.js --verify"
  },
  "dependencies": {
    "kysely": "0.28.17",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@hv/config": "workspace:*",
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.19.0",
    "tsx": "4.23.15"
  }
}
