{
  "name": "@hv/api",
  "version": "0.0.0",
  "private": true,
  "description": "Highland Vault HTTP API (NestJS + Fastify).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "dev": "pnpm run build && pnpm run start",
    "cli:grant-role": "node --env-file-if-exists=../../.env dist/cli/grant-role.js"
  },
  "dependencies": {
    "@hv/contracts": "workspace:*",
    "@hv/db": "workspace:*",
    "@hv/domain": "workspace:*",
    "@hv/payments": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hv/config": "workspace:*",
    "@nestjs/testing": "11.2.5",
    "@types/pg": "8.23.1",
    "pg": "8.23.0"
  }
}
