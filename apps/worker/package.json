{
  "name": "@hv/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Highland Vault background worker (NestJS standalone + BullMQ).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "dev": "pnpm run build && pnpm run start"
  },
  "dependencies": {
    "@hv/db": "workspace:*",
    "@hv/domain": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.0.10",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hv/config": "workspace:*",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.0"
  }
}
