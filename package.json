{
  "name": "highland-vault",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "prettier": "@hv/config/prettier",
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down --volumes && docker compose up -d --wait",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "build": "pnpm -r run build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @hv/api --filter @hv/worker --filter @hv/web run dev",
    "db:migrate": "pnpm --filter @hv/db run migrate",
    "db:codegen": "pnpm --filter @hv/db run codegen",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @hv/web run test:e2e",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:migrate up && pnpm db:migrate verify && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hv/config": "workspace:*",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.11"
  }
}
